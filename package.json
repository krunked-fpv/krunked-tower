{
  "name": "krunked-tower",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Krunked Tower — 60 Hz deterministic kinetic 2D cartoon speed-platformer",
  "scripts": {
    "extract": "tsx tools/extract-assets.ts",
    "oracle": "tsx tools/oracle-dump.ts",
    "dev": "vite --port 5173",
    "play": "vite --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:assets": "tsx scripts/verify/verify-assets.ts",
    "verify:sim": "tsx scripts/verify/verify-sim.ts",
    "verify": "npm run verify:assets && npm run test && npm run verify:sim",
    "build": "tsc --noEmit && vite build",
    "export:dna": "tsx export-dna.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
